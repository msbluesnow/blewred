# ==============================================================================
# BlewRed — Git Attributes & Line Endings Configuration
# ==============================================================================

# Set default behavior: normalize all text files to LF
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source Code (strictly LF line endings across all platforms)
# ------------------------------------------------------------------------------
*.rs text eol=lf diff=rust
*.c text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf

# ------------------------------------------------------------------------------
# Windows Command Shell Scripts (require CRLF to execute properly)
# ------------------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf

# ------------------------------------------------------------------------------
# Binary Assets (raw byte streams, never alter line endings)
# ------------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary

# Executables, dynamic libraries and ML model weights
*.exe binary
*.dll binary
*.lib binary
*.onnx binary
*.onnx.data binary
*.bin binary
*.tar.gz binary
*.zip binary
